# Expert API backend — used by the Next.js proxy (/api/expert/*) on the server.
# Browser Socket.IO reads this via next.config env passthrough and /api/expert/socket-config.
EXPERT_API_BASE_URL=https://coinzy-experts-api.trackzio.com

# Optional overrides (defaults to EXPERT_API_BASE_URL when unset):
# NEXT_PUBLIC_EXPERT_API_BASE_URL=https://coinzy-experts-api.trackzio.com
# NEXT_PUBLIC_EXPERT_SOCKET_URL=https://coinzy-experts-api.trackzio.com

# Used by scripts/seed-expert-panel-live.mjs (local/scripts only — not needed on Netlify)
# ADMIN_API_KEY=
# USER_JWT_SHARED_SECRET=
