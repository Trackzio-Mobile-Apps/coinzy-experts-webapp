# Expert API backend — used by the Next.js proxy (/api/expert/*) on the server.
# Browser calls same-origin /api/expert/... so CORS is not required on the backend.
# Health check: https://coinzy-experts-api.trackzio.com/health
#
# Local: copy to .env.local
# Netlify: Site settings → Environment variables → add EXPERT_API_BASE_URL
#          (Production + Preview scopes). Do NOT set ADMIN_API_KEY / secrets
#          as NEXT_PUBLIC_* — they must stay server-only.
EXPERT_API_BASE_URL=https://coinzy-experts-api.trackzio.com

# Used by scripts/seed-expert-panel-live.mjs (local/scripts only — not needed on Netlify)
# ADMIN_API_KEY=
# USER_JWT_SHARED_SECRET=
